# --- Supabase (Auth + Postgres, région EU/Frankfurt) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_WEBHOOK_SECRET=   # secret du Database Webhook Supabase (auth.users insert), optionnel
DATABASE_URL=              # connection string Postgres (Supabase, pooled)
DIRECT_URL=                # connection string Postgres (Supabase, direct, pour les migrations)

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=   # price Stripe pour l'abonnement Standard 49€/mois
STRIPE_PRICE_ID_PREMIUM=   # price Stripe pour l'abonnement Premium 199€/mois
STRIPE_PRICE_ID_GRATUIT=   # price Stripe pour Impulsion (7 jours offerts, puis 19€/mois)
STRIPE_PRICE_ID_GRATUIT_ANNUAL=   # price Stripe pour Impulsion 190€/an
STRIPE_PRICE_ID_STANDARD_ANNUAL=  # price Stripe pour Transformation 490€/an
STRIPE_PRICE_ID_PROGRAMME_ONE_SHOT=  # paiement unique : Impulsion, génération de programme, 19€ (13/08/2026, nouveau modèle d'accès libre)
AI_INPUT_USD_PER_MILLION=  # optionnel : tarif réel du modèle par million de jetons entrants
AI_OUTPUT_USD_PER_MILLION= # optionnel : tarif réel du modèle par million de jetons sortants

# --- IA (génération de programmes) ---
AI_API_KEY=
AI_MODEL=                  # optionnel, défaut au modèle Claude le plus récent

# --- Notifications email (Resend) ---
RESEND_API_KEY=             # clé API Resend (resend.com), pour notifier le coach
HUBSPOT_ACCESS_TOKEN=       # jeton d'application privée HubSpot (crm.objects.contacts read/write)
ADMIN_NOTIFICATION_EMAIL=   # email d'Anthony, reçoit une notif à chaque programme en attente
RESEND_FROM_EMAIL=          # optionnel, défaut "COAI <onboarding@resend.dev>"

# --- Notification push (ntfy.sh) ---
# 14/08/2026 : les emails de notification atterrissaient en spam (domaine
# d'envoi Resend non vérifié) — ce canal les double sur le téléphone
# d'Anthony, sans dépendre de la délivrabilité email.
# 1. Installer l'app "ntfy" (App Store / Play Store)
# 2. Choisir un nom de topic long et difficile à deviner (ex: coai-anthony-x7f3k9qz)
#    — quiconque connaît ce nom peut recevoir les notifications, à garder secret
# 3. S'abonner à ce topic dans l'app
# 4. Renseigner le même nom ci-dessous
NTFY_TOPIC=                 # topic ntfy.sh privé, ex: coai-anthony-x7f3k9qz
NTFY_SERVER=                # optionnel, défaut https://ntfy.sh (self-host possible)

# --- Intégration WhatsApp (Coaching 2.0 existant : Make.com + Twilio) ---
WHATSAPP_WEBHOOK_SECRET=   # secret partagé pour valider les appels entrants de Make.com
MAKE_OUTGOING_WEBHOOK_URL= # webhook Make.com à notifier lors d'une mise à jour de profil/programme
NEXT_PUBLIC_WHATSAPP_COACH_NUMBER= # numéro WhatsApp d'Anthony au format international sans + ni espaces (ex: 33612345678), pour le CTA "coaching humain en visio"

# --- Suivi d'erreurs (Sentry) ---
NEXT_PUBLIC_SENTRY_DSN=   # DSN du projet Sentry, optionnel (rien n'est envoyé si absent)

# --- Analytics / Ads ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=   # ID de mesure Google Analytics 4 (ex: G-XXXXXXXXXX), optionnel (pas de tracking si absent)
NEXT_PUBLIC_META_PIXEL_ID=       # ID du pixel Meta (Events Manager), optionnel (pas de tracking si absent)
NEXT_PUBLIC_CLARITY_PROJECT_ID=  # ID du projet Microsoft Clarity, optionnel (pas de tracking si absent)

# --- Cron (Vercel) ---
CRON_SECRET=   # secret arbitraire ; Vercel l'ajoute auto en header Authorization sur les requêtes cron (relance des abonnés Impulsion inactifs)
EMAIL_UNSUB_SECRET=   # optionnel, secret dédié pour les liens de désabonnement de la séquence de nurture ; retombe sur CRON_SECRET si absent

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Photos (bibliothèque de recettes) ---
PEXELS_API_KEY=   # clé gratuite sur pexels.com/api ; sans elle, les recettes s'affichent sans photo (jamais d'image cassée)
