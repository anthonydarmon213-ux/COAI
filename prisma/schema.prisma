generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Utilisateur applicatif, lié à l'identité gérée par Supabase Auth (auth.users.id)
model User {
  id             String    @id @default(uuid())
  supabaseAuthId String    @unique
  email          String    @unique
  prenom         String?
  phoneWhatsapp  String?   @unique
  consentRgpdAt  DateTime?
  // Certification santé recueillie à l'inscription : l'utilisateur déclare
  // être apte à la pratique sportive ou avoir consulté un médecin.
  consentSanteAt DateTime?
  // Coach humain (Anthony Darmon) habilité à relire/valider les programmes
  // générés par l'IA avant qu'ils soient visibles par les abonnés.
  isAdmin        Boolean   @default(false)
  // Quota "coach IA" en palier Gratuit (4 questions/mois) — non utilisé
  // pour Standard/Premium (accès illimité). Fenêtre glissante de 30 jours
  // depuis coachQuestionsResetAt, pas un calendrier fixe.
  coachQuestionsUsed    Int       @default(0)
  coachQuestionsResetAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  subscription   Subscription?
  profile        Profile?
  programmes     ProgrammeGenerated[]
  seances        SeanceLog[]
  mesures        Mesure[]
  whatsappEvents WhatsAppEvent[]

  @@map("users")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

// STANDARD = 49€/mois (programme IA + validation coach).
// PREMIUM = 199€/mois (STANDARD + 1 séance/mois en présentiel ou visio,
// version light de THE METHOD qui reste à 4 séances/mois).
// Le palier "Gratuit" n'a pas de ligne Subscription : c'est l'absence
// d'abonnement actif qui le représente.
enum SubscriptionPlan {
  STANDARD
  PREMIUM
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(INCOMPLETE)
  plan                 SubscriptionPlan   @default(STANDARD)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("subscriptions")
}

// Données d'entrée utilisées par l'IA pour générer les programmes.
// Informations relativement stables (contrairement aux Mesure, qui suivent
// leur évolution dans le temps).
model Profile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectifs             String?
  niveau                String?
  equipementDisponible  String?
  contraintesSante      String?
  antecedentsMedicaux   String?
  tailleCm              Float?
  age                   Int?
  sexe                  String?
  morphologie           String?
  frequenceEntrainement String?
  sportsPratiques       String?
  habitudesAlimentaires String?
  repasParJour          String?
  hydratation           String?
  consommationCafe      String?
  consommationAlcool    String?
  qualiteSommeil        String?
  updatedAt             DateTime @updatedAt

  @@map("profiles")
}

enum Pilier {
  ENTRAINEMENT
  NUTRITION
  RECUPERATION
}

enum StatutProgramme {
  EN_ATTENTE
  VALIDE
}

// Historique des programmes générés dynamiquement par l'IA (pas de bibliothèque
// pré-construite). Chaque génération reste EN_ATTENTE tant que le coach humain
// (Anthony Darmon) ne l'a pas relue et validée — l'abonné ne voit que les
// programmes VALIDE.
model ProgrammeGenerated {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pilier      Pilier
  contenu     Json
  statut      StatutProgramme @default(EN_ATTENTE)
  valideAt    DateTime?
  generatedAt DateTime        @default(now())

  @@index([userId, pilier, generatedAt])
  @@index([statut, generatedAt])
  @@map("programmes_generated")
}

model SeanceLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  exercices Json
  ressenti  String?
  notes     String?
  createdAt DateTime @default(now())

  @@map("seances_log")
}

// Données de composition corporelle inspirées d'une balance type InBody —
// suivies dans le temps (contrairement au Profile) pour un vrai graphique
// de progression.
model Mesure {
  id                         String   @id @default(uuid())
  userId                     String
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                       DateTime
  poidsKg                    Float?
  tourTailleCm               Float?
  masseGrassePourcent        Float?
  masseMusculaireKg          Float?
  frequenceCardiaqueReposBpm Int?
  notes                      String?
  // Chemin dans le bucket Supabase Storage "progress-photos" (bucket privé,
  // accès via URL signée générée à la demande) — pas l'URL elle-même.
  photoPath                  String?
  createdAt                  DateTime @default(now())

  @@map("mesures")
}

enum WhatsAppDirection {
  INBOUND
  OUTBOUND
}

// Trace des échanges pertinents avec l'assistant WhatsApp existant (Coaching 2.0)
model WhatsAppEvent {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction WhatsAppDirection
  payload   Json
  createdAt DateTime          @default(now())

  @@map("whatsapp_events")
}

// Bibliothèque de vidéos de coaching (yoga, mobilité, récupération…),
// hébergées en non répertorié sur YouTube. Accessible aux abonnés
// Standard/Premium uniquement (cf. getEffectivePlan) ; gérée par le coach
// depuis /admin/videos. Le paywall est côté COAI, pas côté YouTube — le
// lien "non répertorié" reste techniquement accessible s'il est partagé.
model Video {
  id          String   @id @default(uuid())
  titre       String
  description String?
  youtubeId   String
  categorie   String?
  createdAt   DateTime @default(now())

  @@map("videos")
}

model FounderWaitlistEntry {
  id               String    @id @default(uuid())
  firstName        String?
  email            String    @unique
  phone            String?
  profile          String?
  objective        String?
  consentAt        DateTime
  contactConsentAt DateTime?
  createdAt        DateTime  @default(now())

  @@map("founder_waitlist_entries")
}
