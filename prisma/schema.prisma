generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Utilisateur applicatif, lié à l'identité gérée par Supabase Auth (auth.users.id)
model User {
  id             String    @id @default(uuid())
  supabaseAuthId String    @unique
  email          String    @unique
  prenom         String?
  nom            String?
  dateNaissance  DateTime? @db.Date
  phoneWhatsapp  String?   @unique
  consentRgpdAt  DateTime?
  // Certification santé recueillie à l'inscription : l'utilisateur déclare
  // être apte à la pratique sportive ou avoir consulté un médecin.
  consentSanteAt DateTime?
  // Coach humain (Anthony Darmon) habilité à relire/valider les programmes
  // générés par l'IA avant qu'ils soient visibles par les abonnés.
  isAdmin        Boolean   @default(false)
  // Quota "coach IA" en palier Gratuit (4 questions/mois) — non utilisé
  // pour Standard/Premium (accès illimité). Fenêtre glissante de 30 jours
  // depuis coachQuestionsResetAt, pas un calendrier fixe.
  coachQuestionsUsed    Int       @default(0)
  coachQuestionsResetAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Parrainage (08/08/2026) : code unique généré à la demande (première
  // visite de la page de parrainage), pas à l'inscription — pas besoin
  // d'un code pour qui ne parraine jamais. Quand le filleul passe payant
  // (fin du mois offert), le parrain reçoit 1 mois offert sur son propre
  // abonnement (coupon Stripe, cf. webhooks/stripe/route.ts).
  // recompenseParrainageAppliquee vit sur le FILLEUL : empêche une
  // notification Stripe rejouée de déclencher la récompense deux fois.
  codeParrainage                String?  @unique
  parraineParId                 String?
  parrainePar                   User?    @relation("Parrainages", fields: [parraineParId], references: [id])
  filleuls                      User[]   @relation("Parrainages")
  recompenseParrainageAppliquee Boolean  @default(false)

  // Relance automatique des abonnés inactifs (09/08/2026, tous paliers
  // payants depuis le 11/08/2026) — sert uniquement à espacer les relances
  // (pas de spam quotidien tant que l'utilisateur reste inactif) — cf.
  // /api/cron/relance-inactifs.
  derniereRelanceInactiviteEnvoyeeAt DateTime?

  // Bilan mensuel automatique (11/08/2026) — récap des séances loggées et
  // de la progression (poids, force) envoyé par email à chaque abonné payant
  // actif, environ tous les 30 jours (calculé depuis cette date, pas un jour
  // calendaire fixe, pour étaler l'envoi dans le temps plutôt qu'un pic le
  // 1er du mois). Null tant qu'aucun bilan n'a encore été envoyé — dans ce
  // cas la première échéance se base sur createdAt. Cf.
  // /api/cron/bilan-mensuel.
  dernierBilanMensuelEnvoyeAt DateTime?

  // Alerte sécurité douleur, palier Impulsion (10/08/2026) — même trou que
  // ci-dessus mais côté sécurité plutôt qu'inactivité : contrairement à
  // Transformation (cf. admin/suivi, un coach humain lit les mentions de
  // douleur), une douleur signalée par un abonné Impulsion n'était jusque-là
  // vue par personne. Horodatage de la dernière alerte envoyée (comparé à la
  // date de la séance qui la déclenche, pas une fenêtre de cooldown) pour ne
  // pas renvoyer deux fois pour la même mention — cf. /api/cron/relance-inactifs.
  derniereAlerteDouleurEnvoyeeAt DateTime?

  subscription   Subscription?
  profile        Profile?
  programmes     ProgrammeGenerated[]
  seances        SeanceLog[]
  repasLogs      RepasLog[]
  avis           Avis[]
  mesures        Mesure[]
  testsMaxi      TestMaxi[]
  whatsappEvents WhatsAppEvent[]
  weeklyCheckins WeeklyCheckin[]
  adaptations    ProgrammeAdaptation[]

  @@map("users")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

// GRATUIT = offre d'appel, 1 mois offert puis 9€/mois (essai Stripe avec
// carte obligatoire dès l'inscription — cf. STRIPE_PRICE_ID_GRATUIT).
// STANDARD = 49€/mois (programme IA + validation coach).
// PREMIUM = 199€/mois (STANDARD + 1 séance/mois en présentiel ou visio,
// version light de THE METHOD qui reste à 4 séances/mois).
// Un utilisateur sans ligne Subscription du tout (edge case : compte créé
// avant l'introduction du palier Gratuit payant, ou juste après
// l'inscription avant que le webhook Stripe n'ait tourné) est aussi
// considéré Gratuit par getEffectivePlan().
enum SubscriptionPlan {
  GRATUIT
  STANDARD
  PREMIUM
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(INCOMPLETE)
  plan                 SubscriptionPlan   @default(STANDARD)
  currentPeriodEnd     DateTime?
  // Fin de la période d'essai Stripe (offre Gratuite 1 mois offert). Null
  // hors essai — status reste "ACTIVE" pendant l'essai (trialing y est
  // mappé), donc c'est ce champ qui permet de distinguer "encore en essai"
  // de "déjà passé à 9€/mois".
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("subscriptions")
}

// Données d'entrée utilisées par l'IA pour générer les programmes.
// Informations relativement stables (contrairement aux Mesure, qui suivent
// leur évolution dans le temps).
model Profile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectifs             String?
  niveau                String?
  equipementDisponible  String?
  contraintesSante      String?
  antecedentsMedicaux   String?
  tailleCm              Float?
  poidsKg               Float?
  age                   Int?
  sexe                  String?
  morphologie           String?
  frequenceEntrainement String?
  sportsPratiques       String?
  habitudesAlimentaires String?
  // Allergies, intolérances ou régime alimentaire particulier (végétarien,
  // sans gluten, sans lactose...) — distinct de contraintesSante/
  // antecedentsMedicaux qui couvrent la santé générale, pas l'alimentation.
  allergiesAlimentaires String?
  repasParJour          String?
  hydratation           String?
  consommationCafe      String?
  consommationAlcool    String?
  qualiteSommeil        String?
  // Données extraites automatiquement d'un screenshot de montre/app santé
  // connectée (cf. src/app/api/profil/montre/route.ts) — dernière analyse
  // écrase la précédente, pas d'historique conservé.
  pasMoyenParJour           Int?
  frequenceCardiaqueRepos   Int?
  sommeilMoyenHeures        Float?
  vo2Max                    Float?
  caloriesMoyennesParJour   Int?
  resumeMontre              String?
  derniereAnalyseMontre     DateTime?
  // Données extraites automatiquement d'une photo en tenue de sport (cf.
  // src/app/api/profil/photo-morphologie/route.ts) — observations
  // factuelles utiles à l'entraînement uniquement (posture, équilibre
  // musculaire apparent), jamais un jugement sur l'apparence. Dernière
  // analyse écrase la précédente, pas d'historique conservé, photo jamais
  // stockée.
  morphologieDetectee       String?
  observationsPosture       String?
  derniereAnalysePhoto      DateTime?
  updatedAt             DateTime @updatedAt

  @@map("profiles")
}

enum Pilier {
  ENTRAINEMENT
  NUTRITION
  RECUPERATION
}

// EN_ATTENTE / VALIDE : cycle normal pour les paliers Standard/Premium — le
// coach humain relit et valide avant que le badge "supervisé" n'apparaisse
// (l'abonné voit déjà l'aperçu EN_ATTENTE, avec un badge distinct).
// GENERE_IA : palier Gratuit (9€) uniquement — programme 100% IA, jamais
// envoyé à la file de relecture du coach, visible immédiatement.
enum StatutProgramme {
  EN_ATTENTE
  VALIDE
  GENERE_IA
}

// Historique des programmes générés dynamiquement par l'IA (pas de bibliothèque
// pré-construite). Chaque génération reste EN_ATTENTE tant que le coach humain
// (Anthony Darmon) ne l'a pas relue et validée, sauf pour le palier Gratuit
// (statut GENERE_IA, jamais envoyé en relecture — cf. StatutProgramme).
//
// 11/08/2026 — vision "programme évolutif" : chaque génération créait déjà
// une nouvelle ligne (jamais d'écrasement), ce qui donnait un historique
// implicite. `version` le rend explicite et affichable (V1, V2...), calculé
// en code à la création (max version existante pour ce pilier + 1), pas par
// la base — pas de séquence dédiée à gérer par pilier/utilisateur.
model ProgrammeGenerated {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pilier      Pilier
  contenu     Json
  statut      StatutProgramme @default(EN_ATTENTE)
  version     Int             @default(1)
  valideAt    DateTime?
  generatedAt DateTime        @default(now())

  @@index([userId, pilier, generatedAt])
  @@index([statut, generatedAt])
  @@map("programmes_generated")
}

// Niveau de douleur signalé au check-in post-séance — volontairement à 3
// crans (pas une échelle 1-10) : COAI ne fait pas de diagnostic médical,
// juste un signal "à surveiller" ou "à faire remonter au coach" (cf. moteur
// d'adaptation et alertes coach).
enum NiveauDouleur {
  AUCUNE
  LEGERE
  IMPORTANTE
}

model SeanceLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  exercices Json
  ressenti  String?
  notes     String?
  createdAt DateTime @default(now())

  // Check-in post-séance (11/08/2026) — rapide (1-5, boutons), rempli juste
  // après la séance, distinct du champ libre "ressenti" existant (conservé
  // tel quel pour compatibilité avec les entrées déjà enregistrées). Sert de
  // signal d'entrée au moteur d'adaptation.
  difficulte  Int?           // 1 (très facile) à 5 (très difficile)
  energie     Int?           // 1 (à plat) à 5 (en pleine forme)
  douleur     NiveauDouleur?
  douleurZone String?

  @@map("seances_log")
}

// Statut = un check-in rapide plutôt qu'un journal alimentaire complet
// (peser/lister chaque aliment) — cohérent avec la cible COAI (débutants,
// sédentaires, déjà submergés) : trois boutons, pas un formulaire à
// remplir à chaque repas.
enum StatutRepas {
  COMME_PREVU
  PETIT_ECART
  GROS_ECART
}

model RepasLog {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  statut    StatutRepas
  notes     String?
  createdAt DateTime    @default(now())

  @@map("repas_log")
}

// Retour d'expérience privé (10/08/2026) : un abonné donne son avis pour
// aider à améliorer le produit, envoyé uniquement à Anthony par email —
// pas de mur de témoignages public pour l'instant, décision explicite vu le
// nombre d'abonnés encore très faible (rien à afficher qui ferait preuve
// sociale). Republication en témoignage public envisageable plus tard, au
// cas par cas, pas automatique.
model Avis {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note        Int
  commentaire String
  createdAt   DateTime @default(now())

  @@map("avis")
}

// Lead capturé sur /diagnostic (quiz public, visiteur anonyme) juste avant
// de révéler l'aperçu personnalisé — pas de relation User : la personne n'a
// pas forcément de compte, potentiellement jamais si elle ne s'inscrit pas.
// Permet de la relancer par email même sans inscription immédiate (pas
// d'envoi automatique pour l'instant, juste la capture).
model DiagnosticLead {
  id        String   @id @default(uuid())
  email     String
  reponses  Json
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@map("diagnostic_leads")
}

// Données de composition corporelle inspirées d'une balance type InBody —
// suivies dans le temps (contrairement au Profile) pour un vrai graphique
// de progression.
model Mesure {
  id                         String   @id @default(uuid())
  userId                     String
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                       DateTime
  poidsKg                    Float?
  tourTailleCm               Float?
  masseGrassePourcent        Float?
  masseMusculaireKg          Float?
  frequenceCardiaqueReposBpm Int?
  notes                      String?
  // Chemin dans le bucket Supabase Storage "progress-photos" (bucket privé,
  // accès via URL signée générée à la demande) — pas l'URL elle-même.
  photoPath                  String?
  createdAt                  DateTime @default(now())

  @@map("mesures")
}

// Un test par qualité physique (pas seulement la force) : DEVELOPPE_COUCHE/
// SQUAT/SOULEVE_DE_TERRE/TRACTION pour la force, SOUPLESSE (flexion
// antérieure), EQUILIBRE (appui unipodal yeux fermés), ENDURANCE (test de
// Cooper, distance en 12 min). Pas de test coordination pour l'instant
// (aucun protocole standard retenu).
enum ExerciceMaxi {
  DEVELOPPE_COUCHE
  SQUAT
  SOULEVE_DE_TERRE
  TRACTION
  SOUPLESSE
  EQUILIBRE
  ENDURANCE
  VITESSE
  PUISSANCE
}

// Tests de charge maximale (1RM) — distinct de Mesure (poids/mensurations)
// et des séances loguées : une entrée par test, pour suivre l'évolution de
// la force sur les mouvements de référence. "unite" est déduite de
// l'exercice côté serveur (kg pour les 3 mouvements de force, reps pour la
// traction au poids du corps) plutôt que confiée au client.
model TestMaxi {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercice  ExerciceMaxi
  date      DateTime
  valeur    Float
  unite     String
  notes     String?
  createdAt DateTime     @default(now())

  @@map("tests_maxi")
}

enum WhatsAppDirection {
  INBOUND
  OUTBOUND
}

// Trace des échanges pertinents avec l'assistant WhatsApp existant (Coaching 2.0)
model WhatsAppEvent {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction WhatsAppDirection
  payload   Json
  createdAt DateTime          @default(now())

  @@map("whatsapp_events")
}

// Bibliothèque de vidéos de coaching (yoga, mobilité, récupération…),
// hébergées en non répertorié sur YouTube. Accessible aux abonnés
// Standard/Premium uniquement (cf. getEffectivePlan) ; gérée par le coach
// depuis /admin/videos. Le paywall est côté COAI, pas côté YouTube — le
// lien "non répertorié" reste techniquement accessible s'il est partagé.
model Video {
  id          String   @id @default(uuid())
  titre       String
  description String?
  youtubeId   String
  categorie   String?
  createdAt   DateTime @default(now())

  @@map("videos")
}

model FounderWaitlistEntry {
  id               String    @id @default(uuid())
  firstName        String?
  email            String    @unique
  phone            String?
  profile          String?
  objective        String?
  consentAt        DateTime
  contactConsentAt DateTime?
  createdAt        DateTime  @default(now())

  @@map("founder_waitlist_entries")
}

// Niveau de sommeil déclaré au check-in hebdomadaire — échelle qualitative
// (pas d'heures précises, déjà couvert par qualiteSommeil/sommeilMoyenHeures
// dans Profile pour la donnée de fond) volontairement courte pour rester
// dans l'esprit "moins d'une minute à remplir".
enum NiveauSommeil {
  TRES_MAUVAIS
  MAUVAIS
  CORRECT
  BON
  EXCELLENT
}

// Bilan hebdomadaire (11/08/2026, vision "programme évolutif") — signal
// principal du moteur d'adaptation en complément du check-in post-séance :
// capture ce qui ne se voit pas séance par séance (tendance sommeil/stress/
// motivation sur la semaine). Une entrée par semaine et par utilisateur
// (semaineDebut = lundi de la semaine concernée), tout est facultatif pour
// ne jamais bloquer l'envoi sur un champ non renseigné.
model WeeklyCheckin {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  semaineDebut     DateTime       @db.Date
  sommeil          NiveauSommeil?
  energie          Int?
  stress           Int?
  faim             Int?
  motivation       Int?
  poidsKg          Float?
  douleurs         Boolean?
  seancesRealisees Int?
  commentaire      String?
  createdAt        DateTime       @default(now())

  @@unique([userId, semaineDebut])
  @@map("weekly_checkins")
}

// Décision du moteur d'adaptation pour un pilier donné, à un instant T.
// GARDER = programme inchangé (données insuffisantes ou stables) ;
// PROGRESSER/REDUIRE = ajustement de volume/charge ; MODIFIER = un exercice
// ou une séance change ; ADAPTER = contrainte ponctuelle (ex: voyage).
enum DecisionAdaptation {
  GARDER
  PROGRESSER
  REDUIRE
  MODIFIER
  ADAPTER
}

// APPLIQUEE = palier sans relecture coach obligatoire (Impulsion), la
// nouvelle version est visible immédiatement. EN_ATTENTE/VALIDEE/MODIFIEE
// suivent le même principe que StatutProgramme pour Transformation : le
// coach doit valider une adaptation avant qu'elle ne devienne le programme
// affiché à l'abonné (cf. StatutProgramme.EN_ATTENTE côté ProgrammeGenerated,
// que la nouvelle version porte aussi).
enum StatutAdaptation {
  APPLIQUEE
  EN_ATTENTE
  VALIDEE
  MODIFIEE
}

// Trace explicite de CHAQUE changement de programme et de sa raison (jamais
// de modification silencieuse — exigence centrale de la vision produit) :
// alimente la page "Ton programme évolue" et la timeline "Mon évolution".
// `changements` est un tableau structuré (pas du texte libre) pour rester
// affichable de façon uniforme quel que soit le type de changement :
// [{ type: "LOAD"|"VOLUME"|"EXERCICE"|"CONTRAINTE", cible, avant, apres, raison }]
model ProgrammeAdaptation {
  id                    String             @id @default(uuid())
  userId                String
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  pilier                Pilier
  decision              DecisionAdaptation
  confiance             Float?
  changements           Json
  resume                String
  // Références vers ProgrammeGenerated.id — pas de relation Prisma dédiée
  // (une seule ligne peut avoir besoin de pointer vers l'ancienne ET la
  // nouvelle version du même modèle ; deux relations nommées vers la même
  // table n'apportent pas de garantie supplémentaire ici, le lookup se fait
  // par id applicatif).
  programmePrecedentId String?
  programmeSuivantId    String?
  statut                StatutAdaptation   @default(APPLIQUEE)
  noteCoach             String?
  createdAt             DateTime           @default(now())

  @@index([userId, createdAt])
  @@map("programme_adaptations")
}
